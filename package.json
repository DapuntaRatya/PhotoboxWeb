{
  "name": "photoboxweb",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n api,web \"node --watch server/index.mjs\" \"vite --host 127.0.0.1\"",
    "dev:lan": "concurrently --kill-others -n api,web \"node --watch server/index.mjs\" \"vite --mode lan --host 0.0.0.0 --strictPort\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "cleanup": "node server/storage.mjs",
    "test": "node --test tests/server.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:templates": "node tests/templates.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource/instrument-serif": "^5.2.7",
    "@katana-video/web-bg-removal": "0.1.1",
    "@mediapipe/tasks-vision": "1.2.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "0.35.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.0",
    "playwright": "1.65.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.8"
  }
}
